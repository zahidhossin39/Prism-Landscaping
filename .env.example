# ==============================================================================
# Environment Variables Example Template
# ==============================================================================

# AI Assistant (Chatbot) Configuration
# Copy this file to .env.local and fill in the values:

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI API (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs Conversational Voice Agent
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here


# Website lead capture (contact form + quote modal -> Google Sheet via Apps Script, see scripts/leads-apps-script.gs)
LEADS_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
LEADS_WEBHOOK_TOKEN=any_long_random_string_also_set_in_the_script
