# ==============================================================================
# Environment Variables Example Template
# ==============================================================================

# AI Assistant (Chatbot) Configuration
# Copy this file to .env.local and fill in the values:

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI API (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs Conversational Voice Agent
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here


# Website lead capture (contact form + quote modal -> Google Sheet via Composio)
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_CONNECTED_ACCOUNT_ID=your_googlesheets_connected_account_id_here
LEADS_SHEET_ID=1CxbIH8rS0soj29VfRnBrWERdLh4QMl3vas2PnlKSxyc
